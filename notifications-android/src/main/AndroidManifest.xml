<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          The receive-side FCM entry point. Merged into the consuming app's manifest so a delivered
          push reaches PlatformFirebaseMessagingService without the app declaring anything. The app
          still supplies its own google-services.json (Firebase project config) and registers a
          PushMessageHandler via PlatformFirebaseMessaging.handler or by implementing
          PushMessageHandlerProvider on its Application; with no handler registered a push is dropped,
          never crashes.
        -->
        <service
            android:name=".PlatformFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
